// Multi-tenant QR table-ordering platform.
// Postgres on the venue's own server: a single direct connection, so there is
// no separate pooled/unpooled pair to configure.

generator client {
  provider = "prisma-client-js"
  // The venue terminal runs Windows; builds happen on a developer machine.
  // prisma generate only emits an engine for the host it runs on, so a bundle
  // built on macOS or Linux ships an engine Windows cannot load and the server
  // dies on its first query. Listing the target explicitly puts both engines in
  // the bundle. Add a target here for any OS a venue actually runs.
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Venue {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  currency      String   @default("TRY")
  defaultLocale String   @default("tr")
  // Secret used to HMAC-sign table QR payloads. Rotating a table's qrVersion
  // (not this secret) is the per-table revocation mechanism.
  qrSecret      String
  // Which PosAdapter delivers accepted orders: "console" | "escpos_bridge"
  posAdapter    String   @default("console")
  createdAt     DateTime @default(now())

  tables     Table[]
  categories Category[]
  items      MenuItem[]
  staff      StaffUser[]
  sessions   TableSession[]
  orders     Order[]
  attempts   OrderAttempt[]
  deliveries PosDelivery[]
  bridgeKeys BridgeKey[]
  visits     TableVisit[]
}

model Table {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id])
  // Globally-unique short code embedded in the QR URL.
  code      String   @unique
  name      String
  // Bumped on QR regeneration; old signed URLs become invalid.
  qrVersion Int      @default(1)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  sessions TableSession[]
  orders   Order[]
  visits   TableVisit[]
}

// One party's stay at a table — the unit a bill covers.
//
// A table seats up to MAX_ACTIVE_PER_TABLE phones, each with its own
// TableSession, so a bill cannot be per-session: the visit groups every session
// and order belonging to the same party. It opens when the first phone scans at
// an idle table, and closes when staff settle it at the till.
//
// It also replaces the four-hour window the customer's order list used to use,
// which could show a new party the previous party's orders.
model TableVisit {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])
  tableId String
  table   Table  @relation(fields: [tableId], references: [id])

  // open | bill_requested | closed
  status          String    @default("open")
  openedAt        DateTime  @default(now())
  // Set when a customer taps "hesap istiyorum"; cleared if staff dismiss it.
  billRequestedAt DateTime?
  closedAt        DateTime?
  // settled — staff took payment. abandoned — every session died without
  // settlement (walkout, or staff forgot) and the sweep closed it.
  closedReason    String?

  // Snapshot of the money at settlement, so later menu edits or refunds cannot
  // rewrite what the till actually recorded that night.
  totalKurus      Int?
  paymentMethod   String? // cash | card
  paidAmountKurus Int?
  closedByStaffId String?

  sessions TableSession[]
  orders   Order[]

  // Finding the open visit for a table is the hottest query in the flow.
  @@index([tableId, status])
  @@index([venueId, status])
}

model StaffUser {
  id           String   @id @default(cuid())
  venueId      String
  venue        Venue    @relation(fields: [venueId], references: [id])
  email        String   @unique
  name         String
  passwordHash String
  role         String // "admin" | "desk"
  active       Boolean  @default(true)
  // Bumped to invalidate every token already issued to this account. Staff
  // tokens are stateless JWTs with a 12h life, so without this a password
  // change or a dismissal leaves the old session working until it expires.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
}

model Category {
  id        String  @id @default(cuid())
  venueId   String
  venue     Venue   @relation(fields: [venueId], references: [id])
  nameTr    String
  nameEn    String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  items MenuItem[]
}

model MenuItem {
  id         String   @id @default(cuid())
  venueId    String
  venue      Venue    @relation(fields: [venueId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  nameTr     String
  nameEn     String
  descTr     String   @default("")
  descEn     String   @default("")
  priceKurus Int
  photoUrl   String?
  // Comma-separated tags: "vegan,gluten,nuts" etc.
  tags       String   @default("")
  available  Boolean  @default(true) // the 86 toggle
  sortOrder  Int      @default(0)

  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]
}

model ModifierGroup {
  id        String   @id @default(cuid())
  itemId    String
  item      MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  nameTr    String
  nameEn    String
  minSelect Int      @default(0)
  maxSelect Int      @default(1)
  sortOrder Int      @default(0)

  options ModifierOption[]
}

model ModifierOption {
  id              String        @id @default(cuid())
  groupId         String
  group           ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  nameTr          String
  nameEn          String
  priceDeltaKurus Int           @default(0)
  sortOrder       Int           @default(0)
}

model TableSession {
  id         String      @id @default(cuid())
  venueId    String
  venue      Venue       @relation(fields: [venueId], references: [id])
  tableId    String
  table      Table       @relation(fields: [tableId], references: [id])
  token      String      @unique
  // The party this phone belongs to. Nullable for sessions minted before
  // visits existed.
  visitId    String?
  visit      TableVisit? @relation(fields: [visitId], references: [id])
  createdAt  DateTime    @default(now())
  lastSeenAt DateTime    @default(now())
  // Hard cap; sliding inactivity window is enforced in code against lastSeenAt.
  expiresAt  DateTime
  revokedAt  DateTime?

  orders Order[]
}

model Order {
  id              String       @id @default(cuid())
  venueId         String
  venue           Venue        @relation(fields: [venueId], references: [id])
  tableId         String
  table           Table        @relation(fields: [tableId], references: [id])
  sessionId       String
  session         TableSession @relation(fields: [sessionId], references: [id])
  // The party's visit, so a bill can total the whole table. Nullable for
  // orders placed before visits existed.
  visitId         String?
  visit           TableVisit?  @relation(fields: [visitId], references: [id])
  number          Int // per-venue sequential ticket number
  status          String       @default("received") // received|accepted|preparing|ready|served|rejected
  rejectReason    String?
  totalKurus      Int
  // PSP-ready fields; unused at pay-at-till but stable schema for later.
  paymentStatus   String       @default("unpaid") // unpaid|pending|paid|refunded
  paymentProvider String?
  paymentRef      String?
  // Client-generated per-submission key. A double-tap on a laggy connection
  // sends the same key twice; the second insert loses the unique race and the
  // route returns the order that already exists instead of creating a second.
  idempotencyKey  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  items      OrderItem[]
  deliveries PosDelivery[]
  edits      OrderEdit[]

  // The per-venue ticket number is derived from max(number)+1, which two
  // concurrent orders can read identically under READ COMMITTED. This makes
  // the collision a hard error the route retries, instead of two different
  // orders printing the same ticket number in the kitchen.
  @@unique([venueId, number])
  @@unique([sessionId, idempotencyKey])
  @@index([venueId, status])
  @@index([visitId])
}

model OrderItem {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId         String?
  item           MenuItem? @relation(fields: [itemId], references: [id])
  // Snapshots so later menu edits never rewrite order history.
  nameSnapshot   String
  unitPriceKurus Int
  qty            Int
  note           String    @default("")
  // JSON array of { name, priceDeltaKurus } snapshots.
  modifiersJson  String    @default("[]")
  // Set when staff remove the line from the order. The row is kept rather than
  // deleted so the history of what was ordered survives the correction.
  voidedAt       DateTime?
}

// Who changed an order after it was placed, and what they changed.
//
// Editing an accepted order means the kitchen may hold a paper ticket that no
// longer matches, and the bill total moves. Both are worth being able to answer
// for afterwards, so every correction is recorded with the staff member who
// made it.
model OrderEdit {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  staffId   String
  staffName String
  // JSON: [{ name, fromQty, toQty }] — enough to reconstruct the amendment
  // ticket and to explain a total that changed.
  changesJson String
  // Whether a ticket had already gone to the kitchen when this was made.
  afterPrint  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([orderId])
}

// Every order *attempt*, including ones rejected before an Order exists
// (expired session, invalid QR signature, rate limit) — the abuse-analysis ledger.
model OrderAttempt {
  id        String   @id @default(cuid())
  venueId   String?
  venue     Venue?   @relation(fields: [venueId], references: [id])
  tableId   String?
  sessionId String?
  orderId   String?
  ip        String   @default("")
  userAgent String   @default("")
  outcome   String // ok|invalid_qr|expired_session|revoked_session|rate_limited|table_inactive|validation_error
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([venueId, createdAt])
}

// Outbox for the swappable POS adapter layer. The customer→desk flow never
// depends on rows here succeeding.
model PosDelivery {
  id        String    @id @default(cuid())
  venueId   String
  venue     Venue     @relation(fields: [venueId], references: [id])
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id])
  adapter   String
  status    String    @default("pending") // pending|claimed|sent|failed
  attempts  Int       @default(0)
  lastError String?
  // Set when a pull-based agent claims the row. A claim that is still held
  // after CLAIM_TIMEOUT_MS is assumed dead (agent crashed, lost power, dropped
  // the network mid-print) and is swept back to "pending" for redelivery —
  // without this a stranded claim silently stops the kitchen printing.
  claimedAt DateTime?
  // Identifies which claim attempt won the row, so two agents polling the same
  // venue concurrently can never both be handed the same ticket.
  claimId   String?
  // Pre-rendered ticket payload (base64 ESC/POS bytes or plain text).
  payload   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([venueId, status])
  @@index([status, claimedAt])
}

// API keys for on-prem bridge agents pulling the outbox.
//
// Only a SHA-256 of the key is stored. The plaintext is shown once at creation
// and never again, so a database dump or backup cannot hand out the kitchen
// printer's credential. `hint` keeps the last six characters for telling two
// keys apart on the settings screen.
model BridgeKey {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id])
  keyHash   String   @unique
  hint      String   @default("")
  label     String   @default("kitchen-bridge")
  createdAt DateTime @default(now())
}
